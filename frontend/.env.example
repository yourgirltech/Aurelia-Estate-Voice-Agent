VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# "Talk to Ada" live browser calls (Vapi Web SDK).
# VITE_VAPI_PUBLIC_KEY is the Vapi PUBLIC key — it's designed to be used in
# frontend code and is safe to expose in the browser. Never put the Vapi
# PRIVATE key here or anywhere in the frontend; it belongs only in the
# Edge Function's Supabase secrets.
VITE_VAPI_PUBLIC_KEY=your-vapi-public-key
# The assistant ID for the separate "Ada – Inbound" assistant (handles
# people talking to Ada live, as opposed to the outbound assistant the
# Edge Function calls after a form submission).
VITE_VAPI_INBOUND_ASSISTANT_ID=your-inbound-assistant-id

# Fallback phone option shown next to "Talk to Ada".
# VITE_PHONE_DISPLAY is shown to people; VITE_PHONE_E164 is the same number
# in E.164 format, used for the tel: link.
VITE_PHONE_DISPLAY=+1 (415) 555 0123
VITE_PHONE_E164=+14155550123

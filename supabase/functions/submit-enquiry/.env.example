# Reference only — these are NOT loaded from a file. Set them with:
#   supabase secrets set VAPI_API_KEY=... VAPI_ASSISTANT_ID=... etc.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically to
# every Edge Function by Supabase — you do not need to set them yourself.

VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_VOICE_ID=
COMPANY_NAME=Aurelia Estates

# Optional: restrict CORS to your real frontend domain instead of "*"
ALLOWED_ORIGIN=*

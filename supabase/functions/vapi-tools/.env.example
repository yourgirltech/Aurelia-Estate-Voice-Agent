# Reference only — these are NOT loaded from a file. Set them with:
#   npx supabase secrets set VAPI_TOOLS_SECRET=...
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically to
# every Edge Function by Supabase — you do not need to set them yourself.

# A long random string. Vapi sends this back on every tool call in the
# x-vapi-secret header; requests without a match are rejected with 401.
VAPI_TOOLS_SECRET=
